# Copy to .env. Without Twilio keys, SMS is simulated in the terminal.
PORT=4000
ALERT_PHONES=+919XXXXXXXXX,+919YYYYYYYYY,+919ZZZZZZZZZ   # comma-separated; every number gets each alert
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
CHECK_MINUTES=5
ALERT_AREA=alappuzha   # alappuzha | kuttanad | ambalappuzha | cherthala (area used for SMS alerts)
DEMO_MODE=            # set to flood to start with the preset flood dataset (or use the Simulate flood button)
DISCORD_WEBHOOK_URLS=   # free: Discord channel webhook URL(s), comma-separated
